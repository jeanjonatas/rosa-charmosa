---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/inter';
import '~/styles/global.css';
import { CONTATO } from '~/data/vestidos';
import { asset } from '~/utils/asset';

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  path?: string;
  noindex?: boolean;
};

const {
  title = 'Aluguel de Vestidos de Festa em Goiânia — Setor Campinas | Rosa Charmosa',
  description = 'Aluguel de vestidos de madrinha, formatura, mãe dos noivos e debutante no Setor Campinas, Goiânia. Mais de 13 anos vestindo as Charmosas. Agende sua prova pelo WhatsApp.',
  ogImage = '/og-cover.svg',
  path = '',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://rosacharmosa.com.br';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `${siteUrl}${basePath}${path}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: CONTATO.nome,
  description: 'Loja de locação de vestidos de festa em Goiânia-GO. Madrinhas, formatura, mãe dos noivos, debutantes e convidadas.',
  url: `${siteUrl}${basePath}/`,
  telephone: `+${CONTATO.whatsapp}`,
  image: `${siteUrl}${asset(ogImage)}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTATO.endereco.rua,
    addressLocality: CONTATO.endereco.cidade,
    addressRegion: CONTATO.endereco.estado,
    postalCode: CONTATO.endereco.cep,
    addressCountry: 'BR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '08:00',
      closes: '13:00',
    },
  ],
  sameAs: [CONTATO.instagramUrl],
  priceRange: '$$',
  areaServed: {
    '@type': 'City',
    name: 'Goiânia',
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAFAF7" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={asset('/favicon-512.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('/apple-touch-icon.png')} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rosa Charmosa" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${asset(ogImage)}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${asset(ogImage)}`} />

    <meta name="geo.region" content="BR-GO" />
    <meta name="geo.placename" content="Goiânia" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <script is:inline>
      // Progressive entrance: add .ready after first paint so animations trigger
      requestAnimationFrame(() => document.documentElement.classList.add('is-ready'));

      // IntersectionObserver for "reveal on scroll" elements
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      });

      // Header shrink on scroll
      const header = document.querySelector('header[data-site-header]');
      if (header) {
        let ticking = false;
        const update = () => {
          if (window.scrollY > 24) header.classList.add('is-scrolled');
          else header.classList.remove('is-scrolled');
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
