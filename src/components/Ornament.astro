---
type Props = { variant?: 'line' | 'diamond' | 'flourish'; class?: string };
const { variant = 'diamond', class: className = '' } = Astro.props;
---

{
  variant === 'diamond' && (
    <div class={`ornament ornament-diamond ${className}`} aria-hidden="true">
      <span class="ornament-line"></span>
      <svg viewBox="0 0 24 24" class="ornament-glyph">
        <path d="M12 2 L22 12 L12 22 L2 12 Z" fill="none" stroke="currentColor" stroke-width="0.8" />
        <circle cx="12" cy="12" r="1.6" fill="currentColor" />
      </svg>
      <span class="ornament-line"></span>
    </div>
  )
}

{
  variant === 'flourish' && (
    <div class={`ornament ornament-flourish ${className}`} aria-hidden="true">
      <svg viewBox="0 0 120 20" class="ornament-glyph-wide">
        <path
          d="M4 10 Q 20 2, 40 10 T 80 10 Q 100 18, 116 10"
          fill="none"
          stroke="currentColor"
          stroke-width="0.8"
          stroke-linecap="round"
        />
        <circle cx="60" cy="10" r="1.6" fill="currentColor" />
        <circle cx="20" cy="10" r="0.9" fill="currentColor" opacity="0.6" />
        <circle cx="100" cy="10" r="0.9" fill="currentColor" opacity="0.6" />
      </svg>
    </div>
  )
}

{
  variant === 'line' && (
    <div class={`ornament ornament-line-only ${className}`} aria-hidden="true">
      <span class="ornament-line"></span>
    </div>
  )
}

<style>
  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--color-gold);
    margin-inline: auto;
  }
  .ornament-line {
    display: block;
    height: 1px;
    width: 60px;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-gold) 70%, transparent), transparent);
  }
  .ornament-diamond .ornament-line {
    width: clamp(60px, 18vw, 180px);
  }
  .ornament-glyph {
    width: 16px;
    height: 16px;
  }
  .ornament-glyph-wide {
    width: 120px;
    height: 20px;
  }
  .ornament-line-only .ornament-line {
    width: 100%;
    max-width: 320px;
  }
</style>
