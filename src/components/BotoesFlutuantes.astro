---
import { CONTATO, whatsappLinkFor } from '~/data/vestidos';
---

<div class="fab-stack safe-bottom" aria-label="Contato rápido">
  <a
    href={CONTATO.mapsUrl}
    target="_blank"
    rel="noopener"
    class="fab fab-sm fab-maps"
    style={{ '--fab-delay': '400ms' }}
    aria-label="Abrir rota no Google Maps"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <circle cx="12" cy="9" r="2.3" stroke="currentColor" stroke-width="1.6"/>
    </svg>
    <span class="fab-tooltip">Como chegar</span>
  </a>

  <a
    href={CONTATO.instagramUrl}
    target="_blank"
    rel="noopener"
    class="fab fab-sm fab-insta"
    style={{ '--fab-delay': '300ms' }}
    aria-label="Abrir Instagram @rosacharmosavestidos"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
    </svg>
    <span class="fab-tooltip">Instagram</span>
  </a>

  <a
    href={whatsappLinkFor()}
    target="_blank"
    rel="noopener"
    class="fab fab-main fab-whatsapp"
    style={{ '--fab-delay': '200ms' }}
    aria-label="Agendar pelo WhatsApp"
  >
    <svg class="relative z-10 h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.8-1.6-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.9-2-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2 1.8.8 2.5.9 3.4.7.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.3C8.3 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
    </svg>
    <span class="fab-main-label">Agendar</span>
    <span class="fab-ring"></span>
  </a>
</div>

<style>
  .fab-stack {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .fab-stack {
      right: 1.5rem;
      bottom: 1.5rem;
      gap: 0.75rem;
    }
  }

  .fab {
    pointer-events: auto;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: white;
    text-decoration: none;
    box-shadow: var(--shadow-fab);
    opacity: 0;
    transform: translate3d(0, 20px, 0) scale(0.6);
    animation: fab-in 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.2) var(--fab-delay, 200ms) forwards;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }
  @keyframes fab-in {
    to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }
  .fab:active { transform: scale(0.94); }

  .fab-main {
    height: 4rem;
    min-width: 4rem;
    padding: 0 1.3rem 0 1rem;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }
  .fab-main-label {
    position: relative;
    z-index: 10;
    white-space: nowrap;
  }
  /* On very small screens collapse the label so FAB doesn't dominate */
  @media (max-width: 380px) {
    .fab-main { padding: 0; min-width: 3.75rem; width: 3.75rem; }
    .fab-main-label { display: none; }
  }

  .fab-sm {
    width: 3.25rem;
    height: 3.25rem;
  }


  .fab-whatsapp {
    background: linear-gradient(135deg, #25D366, #128C7E);
  }
  .fab-whatsapp:hover { filter: brightness(1.08); }
  .fab-whatsapp .fab-ring {
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    background: transparent;
    animation: breathe 3.6s ease-in-out infinite;
    box-shadow: 0 0 0 0 color-mix(in oklab, #25D366 60%, transparent);
    pointer-events: none;
  }
  .fab-whatsapp::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid color-mix(in oklab, #25D366 50%, transparent);
    opacity: 0;
    animation: fab-pulse 2.6s ease-out infinite;
    pointer-events: none;
  }
  @keyframes fab-pulse {
    0% { opacity: 0.7; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.4); }
  }

  .fab-insta {
    background: linear-gradient(135deg, #8A3D7A, #D4425E 55%, #F5A24C);
  }
  .fab-maps {
    background: linear-gradient(135deg, var(--color-ink), var(--color-gold-deep));
  }

  .fab-tooltip {
    position: absolute;
    right: calc(100% + 0.6rem);
    top: 50%;
    transform: translate3d(8px, -50%, 0);
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink) 92%, transparent);
    color: var(--color-cream);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  @media (hover: hover) {
    .fab:hover .fab-tooltip {
      opacity: 1;
      transform: translate3d(0, -50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab,
    .fab-whatsapp .fab-ring,
    .fab-whatsapp::after,
    .fab-stack {
      animation: none !important;
      transition: none !important;
    }
    .fab { opacity: 1; transform: none; }
  }
</style>
