---
import { CONTATO, whatsappLinkFor } from '~/data/vestidos';
import { asset } from '~/utils/asset';

const whatsappLink = whatsappLinkFor();

// Curated 3-photo highlight mosaic — 3 full-dress editorial portraits (zero awkward face cropping).
const mosaic = [
  {
    src: '/img/vestidos/real-azul-royal-01-900.webp',
    alt: 'Vestido Azul Royal Princesa — Rosa Charmosa',
    label: 'Azul Royal',
    href: '/vestido/ref-001-azul-royal-princesa',
    position: 'center 12%',
  },
  {
    src: '/img/vestidos/real-serenity-01-frente-900.webp',
    alt: 'Vestido Serenity Floral — Rosa Charmosa',
    label: 'Serenity Floral',
    href: '/vestido/ref-002-serenity-floral',
    position: 'center 10%',
  },
  {
    src: '/img/vestidos/real-champagne-01-900.webp',
    alt: 'Vestido Champagne Franjas — Rosa Charmosa',
    label: 'Champagne',
    href: '/vestido/ref-006-champagne-franjas',
    position: 'center 14%',
  },
];

const destaques = [
  {
    numero: '13 anos',
    titulo: 'de Charmosas',
    detalhe: 'Tradição e carinho no Setor Campinas desde 2013',
    destaque: true,
  },
  {
    numero: '+78 mil',
    titulo: 'no Instagram',
    detalhe: `@${CONTATO.instagramHandle} inspirando todos os dias`,
    href: CONTATO.instagramUrl,
    track: 'instagram',
  },
  {
    numero: '+5.000',
    titulo: 'arrasos em casamentos',
    detalhe: 'Madrinhas, mães dos noivos, formandas e debutantes',
    destaque: true,
  },
  {
    numero: '+200',
    titulo: 'vestidos no acervo',
    detalhe: 'Modelagens exclusivas organizadas por cor e tamanho',
    href: asset('/#catalogo'),
  },
];

const claimWords = CONTATO.claim.split(' ');
---

<section class="hero-section relative isolate overflow-hidden pt-24 pb-14 sm:pt-28 sm:pb-24">
  <div class="aurora pointer-events-none absolute inset-0 -z-10"></div>
  <img
    src={asset('/logo/tulipa-120.webp')}
    alt=""
    aria-hidden="true"
    class="hero-tulipa pointer-events-none absolute select-none"
    width="120"
    height="218"
  />

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {/* Grand editorial opening statement — prominent in body at load, scrolls naturally */}
    <div class="hero-opening relative mx-auto mb-8 max-w-4xl text-center sm:mb-12">
      <h1
        class="hero-claim mx-auto text-balance font-serif text-[2.35rem] font-light leading-[1.08] text-ink sm:text-[3.1rem] md:text-[3.55rem] lg:text-[4.1rem]"
      >
        {
          claimWords.map((word, wi) => {
            const isAccent = word === 'Charmosas' || word === 'vestido' || word === 'dos' || word === 'sonhos';
            return (
              <>
                <span
                  class:list={['hero-word', isAccent && 'italic text-burgundy']}
                  style={{ animationDelay: `${wi * 70}ms` }}
                >
                  {word}
                </span>
                {wi < claimWords.length - 1 ? ' ' : ''}
              </>
            );
          })
        }
      </h1>

      <div class="mt-5 flex items-center justify-center gap-3 text-gold/80" aria-hidden="true">
        <span class="h-px w-12 bg-gradient-to-r from-transparent to-gold/70"></span>
        <span class="text-[0.7rem]">✦</span>
        <span class="h-px w-12 bg-gradient-to-l from-transparent to-gold/70"></span>
      </div>
    </div>

    {/* Main Hero Grid — catalog invitation + 3-photo highlight mosaic */}
    <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-14">
      <div class="relative min-w-0">
        <h2
          class="hero-secondary text-balance font-serif text-[2rem] font-light leading-[1.12] text-ink sm:text-[2.45rem] lg:text-[2.75rem]"
          data-reveal
        >
          O vestido perfeito para você <span class="italic text-burgundy">brilhar no grande dia</span>
        </h2>

        <p class="hero-sub mt-4 max-w-lg text-[0.98rem] font-light leading-relaxed text-ink/75 sm:text-[1.06rem]" data-reveal>
          Explore nosso catálogo organizado por cor, ocasião e modelagem — escolha suas peças favoritas, agende sua prova no sábado e saia pronta para encantar.
        </p>

        <div class="hero-cta mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-reveal>
          <a
            href={asset('/#catalogo')}
            class="cta-primary group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full bg-burgundy-deep px-8 py-[1rem] text-[0.95rem] font-normal tracking-[0.03em] text-cream transition-transform duration-200 active:scale-[0.97]"
          >
            <span class="relative z-10">Explorar catálogo</span>
            <svg class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="cta-glow absolute inset-0 -z-0 rounded-full"></span>
          </a>

          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener"
            data-track="whatsapp"
            data-track-source="hero"
            class="cta-whatsapp group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full px-7 py-[1rem] text-[0.95rem] font-medium tracking-[0.02em] text-white transition-transform duration-200 active:scale-[0.97]"
          >
            <svg class="relative z-10 h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.8-1.6-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.9-2-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2 1.8.8 2.5.9 3.4.7.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.3C8.3 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
            </svg>
            <span class="relative z-10 whitespace-nowrap">Agendar no WhatsApp</span>
            <span class="cta-wa-shine" aria-hidden="true"></span>
          </a>
        </div>

        <a
          href={asset('/#como-funciona')}
          class="hero-sub-link mt-5 inline-flex items-center gap-1.5 text-sm font-light text-ink/65 underline-offset-4 transition-colors hover:text-burgundy hover:underline"
          data-reveal
        >
          Como funciona o aluguel
          <span class="text-gold-deep">→</span>
        </a>
      </div>

      <div class="hero-mosaic w-full min-w-0" aria-label="Vestidos em destaque">
        {
          mosaic.map((m, i) => (
            <a
              href={asset(m.href)}
              class={`mosaic-tile mosaic-tile-${i} group`}
              style={{
                '--tile-delay': `${i * 100 + 220}ms`,
              }}
            >
              <img
                src={asset(m.src)}
                alt={m.alt}
                loading={i < 2 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
                style={{ objectPosition: m.position }}
              />
              <span class="mosaic-scrim" aria-hidden="true"></span>
              <span class="mosaic-caption">{m.label}</span>
            </a>
          ))
        }
      </div>
    </div>

    {/* Featured social-proof showcase strip */}
    <div
      class="hero-stats-showcase mt-12 grid grid-cols-2 gap-3 sm:mt-16 sm:gap-4 lg:grid-cols-4"
      aria-label="Números da Rosa Charmosa"
      data-reveal
    >
      {
        destaques.map((item, idx) => {
          const isExternal = item.href?.startsWith('http');
          const Tag = item.href ? 'a' : 'div';
          return (
            <Tag
              href={item.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
              data-track={item.track}
              data-track-source={item.track ? 'hero_stats' : undefined}
              class:list={[
                'stat-card group relative flex flex-col justify-between overflow-hidden rounded-2xl p-4 sm:p-5',
                item.destaque && 'stat-card-featured',
                item.href && 'cursor-pointer',
              ]}
              style={{ '--stat-delay': `${idx * 80}ms` }}
            >
              <span class="stat-top-line" aria-hidden="true"></span>
              <div class="flex items-baseline justify-between gap-2">
                <p class="stat-number font-serif text-[2rem] font-normal leading-none tracking-tight sm:text-[2.45rem]">
                  {item.numero}
                </p>
                <span class="text-[0.65rem] text-gold-deep/75" aria-hidden="true">✦</span>
              </div>
              <div class="mt-2.5">
                <p class="text-[0.82rem] font-medium uppercase tracking-[0.12em] text-burgundy sm:text-[0.85rem]">
                  {item.titulo}
                </p>
                <p class="mt-1 text-xs font-light leading-snug text-ink/65">
                  {item.detalhe}
                </p>
              </div>
            </Tag>
          );
        })
      }
    </div>
  </div>

  <div class="scroll-cue absolute bottom-4 left-1/2 hidden -translate-x-1/2 sm:block" aria-hidden="true">
    <span class="scroll-cue-line"></span>
  </div>
</section>

<style>
  /* Delicate rose-gold ambient wash right beneath the fixed header */
  .hero-section::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 7.5rem;
    background: linear-gradient(180deg,
      color-mix(in oklab, var(--color-rose) 18%, var(--color-cream)) 0%,
      color-mix(in oklab, var(--color-rose-soft) 22%, transparent) 60%,
      transparent 100%);
    z-index: -2;
    pointer-events: none;
  }

  .aurora {
    background:
      radial-gradient(55% 45% at 20% 15%, color-mix(in oklab, var(--color-gold) 24%, transparent), transparent 65%),
      radial-gradient(45% 40% at 85% 20%, color-mix(in oklab, var(--color-rose) 32%, transparent), transparent 60%),
      radial-gradient(70% 60% at 70% 90%, color-mix(in oklab, var(--color-rose) 16%, transparent), transparent 70%);
    animation: aurora 24s ease-in-out infinite alternate;
    mix-blend-mode: screen;
    opacity: 0.85;
  }

  /* Official tulipa watermark anchor */
  .hero-tulipa {
    top: 46%;
    right: -4%;
    transform: translate3d(0, -50%, 0);
    width: clamp(16rem, 32vw, 25rem);
    height: auto;
    opacity: 0.09;
    z-index: -1;
    object-fit: contain;
  }
  @media (min-width: 1024px) {
    .hero-tulipa { right: -2%; opacity: 0.11; }
  }
  @media (max-width: 640px) {
    .hero-tulipa {
      right: -12%;
      top: 52%;
      opacity: 0.09;
    }
  }

  /* Hero typography reveal */
  .hero-secondary,
  .hero-sub,
  .hero-cta,
  .hero-stats-showcase {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition: opacity 0.85s ease, transform 0.85s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .hero-secondary.in-view,
  .hero-sub.in-view,
  .hero-cta.in-view,
  .hero-stats-showcase.in-view {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .hero-secondary.in-view { transition-delay: 100ms; }
  .hero-sub.in-view { transition-delay: 160ms; }
  .hero-cta.in-view { transition-delay: 220ms; }
  .hero-stats-showcase.in-view { transition-delay: 260ms; }

  .hero-claim .hero-word {
    display: inline-block;
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    filter: blur(5px);
    animation: reveal-word 0.85s cubic-bezier(0.2, 0.9, 0.3, 1) both;
  }
  @keyframes reveal-word {
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      filter: blur(0);
    }
  }

  /* Primary CTA */
  .cta-primary {
    min-height: 50px;
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-gold) 36%, transparent),
                0 10px 26px -10px color-mix(in oklab, var(--color-burgundy-deep) 45%, transparent);
    animation: glow-pulse 3.8s ease-in-out infinite;
  }
  .cta-glow {
    background: linear-gradient(135deg, color-mix(in oklab, var(--color-gold) 42%, transparent), transparent 55%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .cta-primary:hover .cta-glow { opacity: 1; }

  /* WhatsApp CTA */
  .cta-whatsapp {
    min-height: 50px;
    background: linear-gradient(135deg, #25D366, #128C7E);
    box-shadow: 0 2px 6px -1px rgb(37 211 102 / 0.38),
                0 14px 32px -10px rgb(37 211 102 / 0.5),
                inset 0 1px 0 rgb(255 255 255 / 0.25);
  }
  .cta-whatsapp:hover {
    filter: brightness(1.06);
  }
  .cta-wa-shine {
    position: absolute;
    inset-block: 0;
    left: -40%;
    width: 50%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.38), transparent);
    transform: skewX(-18deg);
    animation: wa-shine 4.2s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes wa-shine {
    0%, 65%, 100% { left: -50%; }
    82% { left: 120%; }
  }

  /* Featured social-proof stat cards */
  .stat-card {
    background: linear-gradient(155deg,
      color-mix(in oklab, white 82%, var(--color-cream)) 0%,
      color-mix(in oklab, var(--color-rose-soft) 24%, white) 100%);
    border: 1px solid color-mix(in oklab, var(--color-gold) 32%, transparent);
    box-shadow: 0 2px 8px -2px rgb(95 42 51 / 0.06),
                0 14px 30px -18px rgb(95 42 51 / 0.16);
    transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }
  .stat-card-featured {
    background: linear-gradient(155deg,
      color-mix(in oklab, white 72%, var(--color-rose-soft)) 0%,
      color-mix(in oklab, var(--color-gold-light) 22%, white) 100%);
    border-color: color-mix(in oklab, var(--color-burgundy) 22%, var(--color-gold));
  }
  .stat-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-gold) 65%, transparent);
    box-shadow: 0 4px 12px -2px rgb(95 42 51 / 0.09),
                0 18px 36px -16px rgb(95 42 51 / 0.22);
  }
  .stat-top-line {
    position: absolute;
    inset-inline: 1rem;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-gold), var(--color-rose-deep), transparent);
    opacity: 0.65;
  }
  .stat-number {
    color: var(--color-burgundy-deep);
    background: linear-gradient(135deg, var(--color-burgundy-deep) 20%, var(--color-burgundy-soft) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Editorial 3-photo highlight mosaic — portrait-friendly frames at every breakpoint */
  .hero-mosaic {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: 1fr 1fr;
    aspect-ratio: 4 / 4.55;
  }
  @media (min-width: 1024px) {
    .hero-mosaic {
      gap: 0.9rem;
      grid-template-columns: 1.22fr 1fr;
      aspect-ratio: 4 / 4.65;
    }
  }

  .mosaic-tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: var(--shadow-card);
    background: color-mix(in oklab, var(--color-cream-deep) 45%, white);
    border: 1px solid color-mix(in oklab, var(--color-gold) 24%, transparent);
    transform: translate3d(0, 22px, 0) scale(0.97);
    opacity: 0;
    animation: mosaic-in 0.95s cubic-bezier(0.2, 0.9, 0.3, 1) var(--tile-delay) forwards;
    min-height: 0;
    min-width: 0;
  }
  .mosaic-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: ken-burns-a 18s ease-in-out infinite alternate;
    transition: transform 0.7s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .mosaic-tile-1 img { animation-name: ken-burns-b; animation-duration: 20s; }
  .mosaic-tile-2 img { animation-name: ken-burns-a; animation-duration: 22s; }

  .mosaic-tile-0 { grid-column: 1 / 2; grid-row: 1 / 3; }
  .mosaic-tile-1 { grid-column: 2 / 3; grid-row: 1 / 2; }
  .mosaic-tile-2 { grid-column: 2 / 3; grid-row: 2 / 3; }

  .mosaic-scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 36%;
    background: linear-gradient(to top, rgb(42 26 30 / 0.62) 0%, transparent 100%);
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .mosaic-caption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.65rem;
    z-index: 2;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.98rem;
    letter-spacing: 0.02em;
    color: var(--color-cream);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.45);
    transition: transform 0.3s ease;
  }
  @media (hover: hover) {
    .mosaic-tile:hover .mosaic-caption {
      transform: translateY(-2px);
    }
  }

  @keyframes mosaic-in {
    to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  /* Scroll cue */
  .scroll-cue-line {
    display: block;
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom, transparent, var(--color-gold), transparent);
    background-size: 100% 200%;
    animation: scroll-cue 2.4s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% { background-position: 0 -100%; }
    100% { background-position: 0 200%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word,
    .mosaic-tile,
    .mosaic-tile img,
    .aurora,
    .cta-primary,
    .cta-wa-shine,
    .scroll-cue-line {
      animation: none !important;
    }
    .cta-wa-shine { display: none; }
    .hero-word { opacity: 1; transform: none; filter: none; }
    .mosaic-tile { opacity: 1; transform: none; }
  }
</style>
