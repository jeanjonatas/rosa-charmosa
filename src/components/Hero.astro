---
import { CONTATO, whatsappLinkFor } from '~/data/vestidos';
import { asset } from '~/utils/asset';

const claim = CONTATO.claim;
const whatsappLink = whatsappLinkFor();

// Curated mosaic — 4 real photos, one per angle of the hero pieces.
const mosaic = [
  { src: '/img/vestidos/real-azul-royal-01-900.webp', alt: 'Azul Royal' },
  { src: '/img/vestidos/real-serenity-01-frente-900.webp', alt: 'Serenity Floral' },
  { src: '/img/vestidos/real-champagne-01-900.webp', alt: 'Champagne' },
  { src: '/img/vestidos/real-serenity-03-detalhe-900.webp', alt: 'Serenity detalhe' },
];

function splitWords(text: string) {
  return text.split(' ');
}
---

<section class="hero-section relative isolate overflow-hidden pt-28 pb-14 sm:pt-36 sm:pb-24">
  <div class="aurora pointer-events-none absolute inset-0 -z-10"></div>
  <img
    src={asset('/logo/tulipa-120.webp')}
    alt=""
    aria-hidden="true"
    class="hero-tulipa pointer-events-none absolute select-none"
    width="120"
    height="240"
  />
  <div class="hero-estd pointer-events-none select-none" aria-hidden="true">
    <span class="hero-estd-line"></span>
    <span>Estd. 2013 · Goiânia</span>
    <span class="hero-estd-line"></span>
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-16">
    <div class="relative">
      <p
        class="hero-eyebrow inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.3em] text-ink/55"
        data-reveal
      >
        <span class="h-px w-6 bg-gold"></span>
        Goiânia · Setor Campinas
      </p>

      <h1
        class="hero-claim mt-5 text-balance font-serif text-4xl leading-[1.08] text-ink sm:text-5xl md:text-[3.3rem] lg:text-[3.6rem]"
      >
        {
          splitWords(claim).map((word, wi) => (
            <>
              <span class="hero-word" style={{ animationDelay: `${wi * 110}ms` }}>
                {word}
              </span>
              {wi < splitWords(claim).length - 1 ? ' ' : ''}
            </>
          ))
        }
      </h1>

      <p class="hero-sub mt-6 max-w-lg text-base leading-relaxed text-ink/70 sm:text-lg" data-reveal>
        Catálogo completo organizado por cor — escolha a peça, agende sua prova no sábado, e saia pronta pro grande dia.
      </p>

      <div class="hero-cta mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-reveal>
        <a
          href={asset('/#catalogo')}
          class="cta-primary group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full bg-ink px-8 py-[1.05rem] text-base font-semibold text-cream transition-transform duration-200 active:scale-[0.97] sm:text-[0.95rem]"
        >
          <span class="relative z-10">Ver catálogo</span>
          <svg class="relative z-10 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="cta-glow absolute inset-0 -z-0 rounded-full"></span>
        </a>

        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener"
          class="cta-whatsapp group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full px-7 py-[1.05rem] text-base font-semibold text-white transition-transform duration-200 active:scale-[0.97] sm:text-[0.95rem]"
        >
          <svg class="relative z-10 h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.8-1.6-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.9-2-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2 1.8.8 2.5.9 3.4.7.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.3C8.3 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
          </svg>
          <span class="relative z-10 whitespace-nowrap">Agendar no WhatsApp</span>
          <span class="cta-wa-shine" aria-hidden="true"></span>
        </a>
      </div>

      <a
        href={asset('/#como-funciona')}
        class="hero-sub-link mt-5 inline-flex items-center gap-1.5 text-sm text-ink/60 underline-offset-4 transition-colors hover:text-ink hover:underline"
        data-reveal
      >
        Como funciona o aluguel
        <span class="text-gold">→</span>
      </a>

      <div class="hero-stats mt-10 grid grid-cols-3 gap-4 border-t border-ink/10 pt-6 text-sm sm:max-w-md" data-reveal>
        <div>
          <p class="font-serif text-2xl text-ink">13</p>
          <p class="text-xs text-ink/55">anos de Charmosas</p>
        </div>
        <div>
          <p class="font-serif text-2xl text-ink">78k</p>
          <p class="text-xs text-ink/55">no Instagram</p>
        </div>
        <div>
          <p class="font-serif text-2xl text-ink">+200</p>
          <p class="text-xs text-ink/55">peças no acervo</p>
        </div>
      </div>
    </div>

    <div class="hero-mosaic w-full" aria-hidden="true">
      {
        mosaic.map((m, i) => (
          <figure
            class={`mosaic-tile mosaic-tile-${i}`}
            style={{
              '--tile-delay': `${i * 90 + 300}ms`,
            }}
          >
            <img
              src={asset(m.src)}
              alt=""
              loading={i < 2 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
  </div>

  <div class="scroll-cue absolute bottom-6 left-1/2 hidden -translate-x-1/2 sm:block" aria-hidden="true">
    <span class="scroll-cue-line"></span>
  </div>
</section>

<style>
  /* Marsala band extending from the header down into the hero */
  .hero-section::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 22%;
    background: linear-gradient(180deg,
      var(--color-burgundy-deep) 0%,
      var(--color-burgundy) 40%,
      color-mix(in oklab, var(--color-burgundy) 60%, var(--color-cream)) 75%,
      transparent 100%);
    z-index: -2;
    pointer-events: none;
  }

  .aurora {
    background:
      radial-gradient(55% 45% at 20% 15%, color-mix(in oklab, var(--color-gold) 30%, transparent), transparent 65%),
      radial-gradient(45% 40% at 85% 20%, color-mix(in oklab, var(--color-rose) 40%, transparent), transparent 60%),
      radial-gradient(70% 60% at 70% 90%, color-mix(in oklab, var(--color-rose) 18%, transparent), transparent 70%);
    animation: aurora 24s ease-in-out infinite alternate;
    mix-blend-mode: screen;
    opacity: 0.85;
  }

  /* Official tulipa (original asset) as watermark anchor */
  .hero-tulipa {
    top: 48%;
    right: -4%;
    transform: translate3d(0, -50%, 0);
    width: clamp(18rem, 36vw, 28rem);
    height: auto;
    opacity: 0.1;
    z-index: -1;
    object-fit: contain;
  }
  @media (min-width: 1024px) {
    .hero-tulipa { right: -2%; opacity: 0.13; }
  }
  @media (max-width: 640px) {
    .hero-tulipa {
      right: -14%;
      top: 58%;
      opacity: 0.11;
    }
  }

  /* Signature line "Estd. 2013" — sits just below the header's bottom edge */
  .hero-estd {
    position: absolute;
    top: calc(5rem + 0.9rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-cream) 90%, transparent);
    z-index: 3;
    white-space: nowrap;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
  }
  @media (min-width: 640px) {
    .hero-estd {
      top: calc(6rem + 1rem);
      font-size: 0.78rem;
      letter-spacing: 0.3em;
    }
  }
  .hero-estd-line {
    height: 1px;
    width: clamp(28px, 6vw, 60px);
    background: linear-gradient(90deg, transparent, var(--color-gold-light), transparent);
  }

  /* Hero typography reveal */
  .hero-eyebrow,
  .hero-sub,
  .hero-cta,
  .hero-stats {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .hero-eyebrow.in-view,
  .hero-sub.in-view,
  .hero-cta.in-view,
  .hero-stats.in-view {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .hero-sub.in-view { transition-delay: 150ms; }
  .hero-cta.in-view { transition-delay: 250ms; }
  .hero-stats.in-view { transition-delay: 350ms; }

  .hero-claim .hero-word {
    display: inline-block;
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    filter: blur(6px);
    animation: reveal-word 0.9s cubic-bezier(0.2, 0.9, 0.3, 1) both;
  }
  @keyframes reveal-word {
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      filter: blur(0);
    }
  }

  /* Primary CTA with gold glow */
  .cta-primary {
    min-height: 52px;
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-gold) 40%, transparent),
                0 8px 24px -8px color-mix(in oklab, var(--color-ink) 30%, transparent);
    animation: glow-pulse 3.6s ease-in-out infinite;
  }
  .cta-glow {
    background: linear-gradient(135deg, color-mix(in oklab, var(--color-gold) 40%, transparent), transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .cta-primary:hover .cta-glow { opacity: 1; }

  /* WhatsApp CTA — big and vibrant */
  .cta-whatsapp {
    min-height: 52px;
    background: linear-gradient(135deg, #25D366, #128C7E);
    box-shadow: 0 2px 6px -1px rgb(37 211 102 / 0.4),
                0 16px 36px -10px rgb(37 211 102 / 0.55),
                inset 0 1px 0 rgb(255 255 255 / 0.25);
  }
  .cta-whatsapp:hover {
    filter: brightness(1.08);
  }
  .cta-wa-shine {
    position: absolute;
    inset-block: 0;
    left: -40%;
    width: 50%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.4), transparent);
    transform: skewX(-18deg);
    animation: wa-shine 4s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes wa-shine {
    0%, 65%, 100% { left: -50%; }
    82% { left: 120%; }
  }

  /* Mosaic — CSS Grid, responsive, 4 tiles */
  .hero-mosaic {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    aspect-ratio: 1 / 1;
  }
  @media (min-width: 1024px) {
    .hero-mosaic {
      aspect-ratio: 4 / 5;
      gap: 1rem;
    }
  }

  .mosaic-tile {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    box-shadow: var(--shadow-card);
    background: color-mix(in oklab, var(--color-cream-deep) 50%, white);
    transform: translate3d(0, 24px, 0) scale(0.96);
    opacity: 0;
    animation: mosaic-in 1s cubic-bezier(0.2, 0.9, 0.3, 1) var(--tile-delay) forwards;
    min-height: 0;
    min-width: 0;
  }
  .mosaic-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    animation: ken-burns-a 16s ease-in-out infinite alternate;
  }
  .mosaic-tile-1 img { animation-name: ken-burns-b; animation-duration: 18s; }
  .mosaic-tile-3 img { animation-name: ken-burns-b; animation-duration: 20s; }

  @keyframes mosaic-in {
    to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  /* MOBILE/TABLET: 3-col × 3-row grid — simple and robust */
  .mosaic-tile-0 { grid-column: 1 / 3; grid-row: 1 / 3; }  /* large square top-left */
  .mosaic-tile-1 { grid-column: 3 / 4; grid-row: 1 / 2; }  /* top-right */
  .mosaic-tile-2 { grid-column: 3 / 4; grid-row: 2 / 3; }  /* middle-right */
  .mosaic-tile-3 { grid-column: 1 / 4; grid-row: 3 / 4; }  /* full-width bottom */

  /* DESKTOP: taller, more editorial */
  @media (min-width: 1024px) {
    .hero-mosaic {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(4, 1fr);
    }
    .mosaic-tile-0 { grid-column: 1 / 3; grid-row: 1 / 4; }  /* big left, 2 cols × 3 rows */
    .mosaic-tile-1 { grid-column: 3 / 4; grid-row: 1 / 3; }  /* top-right, 1 col × 2 rows */
    .mosaic-tile-2 { grid-column: 3 / 4; grid-row: 3 / 5; }  /* bottom-right, 1 col × 2 rows */
    .mosaic-tile-3 { grid-column: 1 / 3; grid-row: 4 / 5; }  /* bottom-left wide, 2 cols × 1 row */
  }

  /* Scroll cue */
  .scroll-cue-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, var(--color-gold), transparent);
    background-size: 100% 200%;
    animation: scroll-cue 2.4s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% { background-position: 0 -100%; }
    100% { background-position: 0 200%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word,
    .mosaic-tile,
    .mosaic-tile img,
    .aurora,
    .cta-primary,
    .cta-wa-shine,
    .scroll-cue-line {
      animation: none !important;
    }
    .cta-wa-shine { display: none; }
    .hero-word { opacity: 1; transform: none; filter: none; }
    .mosaic-tile { opacity: 1; transform: none; }
  }
</style>
