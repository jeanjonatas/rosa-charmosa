# Tracking & Domain Verification (todos opcionais)
# Preencha os IDs em producao (.env ou GitHub Actions Secrets / Variables)
# para ativar automaticamente sem alterar o codigo.

# Meta Pixel (Facebook / Instagram Ads) — ex: 123456789012345
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (gtag.js) — ex: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Tag Manager (opcional, caso prefira gerenciar tags via GTM) — ex: GTM-XXXXXXX
PUBLIC_GTM_ID=

# Verificacao de dominio no Meta Business Manager
PUBLIC_META_DOMAIN_VERIFICATION=

# Verificacao de propriedade no Google Search Console
PUBLIC_GOOGLE_SITE_VERIFICATION=
